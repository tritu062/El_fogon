datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modelo de Usuario
model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String         // Contraseña hasheada con bcrypt
  firstName     String         @map("first_name")
  lastName      String         @map("last_name")
  isActive      Boolean        @default(true) @map("is_active")
  loginAttempts Int            @default(0) @map("login_attempts") // Intentos fallidos de inicio de sesión
  lockUntil     DateTime?      @map("lock_until") // Bloqueo temporal de la cuenta
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at") // Soft delete

  // Relaciones
  roles         UserRole[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  orders        Order[]
  cashRegisters CashRegister[]
  bills         Bill[]
  inventoryMovements InventoryMovement[]

  @@map("users")
}

// Modelo de Rol
model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique // Ejemplo: "ADMINISTRADOR", "MESERO"
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at") // Soft delete

  // Relaciones
  users       UserRole[]

  @@map("roles")
}

// Tabla Intermedia explícita de relación Muchos a Muchos entre Usuario y Rol
model UserRole {
  userId    Int       @map("user_id")
  roleId    Int       @map("role_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // Soft delete

  // Relaciones y constraints de FK
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// Modelo de Registro de Auditoría para Seguridad e Historial
model AuditLog {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id") // Opcional
  action      String    // Ejemplo: "LOGIN_FALLIDO", "CREAR_PEDIDO"
  description String    // Detalle legible de la acción
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  // Relación
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// Modelo para almacenamiento de Refresh Tokens activos
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relación
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Modelo para áreas físicas del restaurante
model Zone {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  // Relaciones
  tables      Table[]

  @@map("zones")
}

// Estados de una mesa
enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

// Modelo para mesas individuales
model Table {
  id        Int         @id @default(autoincrement())
  number    Int         @unique // Identificador correlativo único de la mesa
  status    TableStatus @default(FREE)
  zoneId    Int         @map("zone_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  deletedAt DateTime?   @map("deleted_at") // Soft delete

  // Relación
  zone      Zone        @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  orders    Order[]

  @@map("tables")

}

// Modelo para categorías del menú (ej: Corrientes, Ejecutivos, Especiales)
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  // Relaciones
  items       Item[]

  @@map("categories")
}

// Modelo para platos y bebidas
model Item {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Int       // Almacenado en centavos (ej: 1550 para $15.50)
  imageUrl    String?   @map("image_url")
  isAvailable Boolean   @default(true) @map("is_available")
  modifiers   Json?     // Modificadores de plato en formato JSON estructurado
  categoryId  Int       @map("category_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at") // Soft delete

  // Relaciones
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]

  @@map("items")
}

// Tipo de pedido (presencial, para llevar, o a domicilio)
enum OrderType {
  PRESENCIAL
  PARA_LLEVAR
  DOMICILIO
}

// Estados del pedido
enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

// Modelo de Pedido / Comanda
model Order {
  id              Int         @id @default(autoincrement())
  status          OrderStatus @default(PENDING)
  orderType       OrderType   @default(PRESENCIAL) @map("order_type")
  isBillRequested Boolean     @default(false) @map("is_bill_requested")
  tableId         Int?        @map("table_id") // Nullable para "Para llevar" / "Delivery"
  waiterId  Int         @map("waiter_id") // Mesero que registró el pedido
  total     Int         @default(0)       // En centavos
  createdAt DateTime    @default(now())   @map("created_at")
  updatedAt DateTime    @updatedAt        @map("updated_at")
  deletedAt DateTime?   @map("deleted_at") // Soft delete

  // Relaciones
  table     Table?      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  waiter    User        @relation(fields: [waiterId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  bill      Bill?

  @@index([status, createdAt])
  @@map("orders")
}

// Modelo de detalle del Pedido (Ítems en comanda)
model OrderItem {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  itemId            Int       @map("item_id")
  quantity          Int       @default(1)
  price             Int       // Precio de venta histórico en centavos
  notes             String?   // Notas de cocina (ej: "Sin cebolla")
  selectedModifiers Json?     @map("selected_modifiers") // Modificadores aplicados en formato JSON
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at") // Soft delete

  // Relaciones
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id                     Int                @id @default(autoincrement())
  cashierId              Int                @map("cashier_id")
  openingTime            DateTime           @default(now()) @map("opening_time")
  closingTime            DateTime?          @map("closing_time")
  openingBalance         Int                @map("opening_balance") // En centavos
  expectedClosingBalance Int?               @map("expected_closing_balance") // En centavos
  actualClosingBalance   Int?               @map("actual_closing_balance") // En centavos
  discrepancy            Int?               @map("discrepancy") // En centavos
  notes                  String?
  status                 CashRegisterStatus @default(OPEN)
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  deletedAt              DateTime?          @map("deleted_at")

  // Relaciones
  cashier                User               @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  bills                  Bill[]

  @@index([cashierId, status])
  @@map("cash_registers")
}

model Bill {
  id              Int          @id @default(autoincrement())
  orderId         Int          @unique @map("order_id")
  cashierId       Int          @map("cashier_id")
  cashRegisterId  Int          @map("cash_register_id")
  subtotal        Int          // En centavos
  tax             Int          @default(0) // En centavos
  discount        Int          @default(0) // En centavos
  total           Int          // En centavos
  invoiceNumber   String       @unique @map("invoice_number")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  deletedAt       DateTime?    @map("deleted_at")

  // Relaciones
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cashier         User         @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  payments        Payment[]

  @@index([createdAt])
  @@index([cashierId])
  @@map("bills")
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

model Payment {
  id        Int           @id @default(autoincrement())
  billId    Int           @map("bill_id")
  amount    Int           // En centavos
  method    PaymentMethod
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  deletedAt DateTime?     @map("deleted_at")

  // Relaciones
  bill      Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// Modelo de Insumos / Ingredientes de Inventario
model Ingredient {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  category     String              @default("ABARROTES") // Ej: "CARNES", "VERDURAS", "LACTEOS", "ABARROTES", "BEBIDAS", "DESECHABLES"
  unit         String              @default("UNIDADES")  // Ej: "KG", "LB", "LITROS", "UNIDADES", "PAQUETES"
  currentStock Float               @default(0) @map("current_stock")
  minStock     Float               @default(0) @map("min_stock")
  unitCost     Int                 @default(0) @map("unit_cost") // En centavos
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  deletedAt    DateTime?           @map("deleted_at") // Soft delete

  // Relaciones
  movements    InventoryMovement[]

  @@map("ingredients")
}

enum MovementType {
  DAILY_CONSUMPTION // Consumo diario registrado al cierre/jornada
  PURCHASE          // Compra / Reabastecimiento de mercancía
  WASTAGE           // Merma, pérdida o daño
  ADJUSTMENT        // Ajuste de inventario físico
}

model InventoryMovement {
  id             Int          @id @default(autoincrement())
  ingredientId   Int          @map("ingredient_id")
  registeredById Int          @map("registered_by_id")
  type           MovementType
  quantity       Float        // Positivo para compras/ajustes, positivo en consumo/merma
  unitCost       Int?         @map("unit_cost") // Costo unitario en centavos al momento del movimiento
  totalCost      Int?         @map("total_cost") // Costo total calculated en centavos
  notes          String?
  date           DateTime     @default(now())

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relaciones
  ingredient     Ingredient   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  registeredBy   User         @relation(fields: [registeredById], references: [id], onDelete: Restrict)

  @@index([ingredientId, date])
  @@map("inventory_movements")
}

